
(rules PCB CoCoTANG
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 27817)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.3)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.8)
    )
  )
  (rule
    (width 152.4)
    (clearance 152.4)
    (clearance 76.2 (type smd_to_turn_gap))
    (clearance 152.4 (type smd))
    (clearance 152.4 (type "kicad_default"))
    (clearance 152.4 (type GND))
    (clearance 152.4 (type +3.3V))
    (clearance 152.4 (type kicad))
  )
  (padstack "Via[0-1]_457.2:203.2_um"
    (shape
      (circle F.Cu 457.2 0.0 0.0)
    )
    (shape
      (circle B.Cu 457.2 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-1]_558.8:304.8_um"
    (shape
      (circle F.Cu 558.8 0.0 0.0)
    )
    (shape
      (circle B.Cu 558.8 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_457.2:203.2_um" "Via[0-1]_457.2:203.2_um" default
  )
  (via 
    "Via[0-1]_558.8:304.8_um" "Via[0-1]_558.8:304.8_um" default
  )
  (via 
    "Via[0-1]_457.2:203.2_um-kicad_default" "Via[0-1]_457.2:203.2_um" "kicad_default"
  )
  (via 
    "Via[0-1]_558.8:304.8_um-kicad_default" "Via[0-1]_558.8:304.8_um" "kicad_default"
  )
  (via 
    "Via[0-1]_457.2:203.2_um-GND" "Via[0-1]_457.2:203.2_um" default
  )
  (via 
    "Via[0-1]_558.8:304.8_um-GND" "Via[0-1]_558.8:304.8_um" default
  )
  (via 
    "Via[0-1]_457.2:203.2_um-+5V" "Via[0-1]_457.2:203.2_um" default
  )
  (via 
    "Via[0-1]_558.8:304.8_um-+5V" "Via[0-1]_558.8:304.8_um" default
  )
  (via 
    "Via[0-1]_457.2:203.2_um-+3.3V" "Via[0-1]_457.2:203.2_um" default
  )
  (via 
    "Via[0-1]_558.8:304.8_um-+3.3V" "Via[0-1]_558.8:304.8_um" default
  )
  (via_rule
    default "Via[0-1]_457.2:203.2_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_457.2:203.2_um-kicad_default"
  )
  (via_rule
    GND "Via[0-1]_558.8:304.8_um-GND"
  )
  (via_rule
    +5V "Via[0-1]_558.8:304.8_um-+5V"
  )
  (via_rule
    +3.3V "Via[0-1]_558.8:304.8_um-+3.3V"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 152.4)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "AUDIO_RCA" "unconnected-(J6-Pin_1-Pad1)" "unconnected-(J6-Pin_2-Pad2)" "unconnected-(J6-Pin_3-Pad3)" "unconnected-(J6-Pin_4-Pad4)" "unconnected-(J6-Pin_5-Pad5)" "unconnected-(J6-Pin_6-Pad6)" "unconnected-(J6-Pin_7-Pad7)"
    "unconnected-(J6-Pin_8-Pad8)" "unconnected-(J6-Pin_9-Pad9)" "unconnected-(J6-Pin_10-Pad10)" "unconnected-(J22-Pin_1-Pad1)" "unconnected-(J22-Pin_2-Pad2)" "Net-(Q2-Pad1)" "AUDIO_33" "Net-(C24-Pad2)"
    "R_CVBS_33" "Net-(Q5-Pad1)" "B_CHR_33" "G_Y_33" "Net-(Q4-Pad2)" "R_CVBS" "Net-(Q2-Pad2)" "G_Y"
    "Net-(JP2-A)" "B_CHR" "Net-(Q4-Pad1)" "Net-(Q5-Pad2)" "unconnected-(J20-Pin_1-Pad1)" "unconnected-(J20-Pin_2-Pad2)" "unconnected-(J11-Pin_1-Pad1)" "unconnected-(J11-Pin_2-Pad2)"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 152.4)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class GND
