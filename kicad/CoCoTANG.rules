
(rules PCB CoCoTANG
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 50)
    (start_pass_no 33815)
    (layer_rule F.Cu
