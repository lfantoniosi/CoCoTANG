
(rules PCB CoCoTANG
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 78085)
    (layer_rule F.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.6)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.6)
    )
  )
  (rule
    (width 152.4)
    (clearance 152.4)
    (clearance 76.2 (type smd_to_turn_gap))
    (clearance 152.4 (type smd))
    (clearance 152.4 (type "kicad_default"))
    (clearance 152.4 (type GND))
    (clearance 152.4 (type +5V))
    (clearance 152.4 (type +3.3V))
    (clearance 152.4 (type kicad))
  )
  (padstack "Via[0-1]_457.2:203.2_um"
    (shape
      (circle F.Cu 457.2 0.0 0.0)
    )
    (shape
      (circle B.Cu 457.2 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_457.2:203.2_um" "Via[0-1]_457.2:203.2_um" default
  )
  (via 
    "Via[0-1]_457.2:203.2_um-kicad_default" "Via[0-1]_457.2:203.2_um" "kicad_default"
  )
  (via 
    "Via[0-1]_457.2:203.2_um-GND" "Via[0-1]_457.2:203.2_um" GND
  )
  (via 
    "Via[0-1]_457.2:203.2_um-+5V" "Via[0-1]_457.2:203.2_um" default
  )
  (via 
    "Via[0-1]_457.2:203.2_um-+3.3V" "Via[0-1]_457.2:203.2_um" default
  )
  (via_rule
    default "Via[0-1]_457.2:203.2_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_457.2:203.2_um-kicad_default"
  )
  (via_rule
    GND "Via[0-1]_457.2:203.2_um-GND"
  )
  (via_rule
    +5V "Via[0-1]_457.2:203.2_um-+5V"
  )
  (via_rule
    +3.3V "Via[0-1]_457.2:203.2_um-+3.3V"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 152.4)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "@kicad-selection-only@@AUDIO_33" "@kicad-selection-only@@Y_VDG" "@kicad-selection-only@@AUDIO_RCA" "@kicad-selection-only@@Net-(C20-Pad1)" "@kicad-selection-only@@Y_33" "@kicad-selection-only@@CHB_33" "@kicad-selection-only@@CHA_33" "@kicad-selection-only@@CLRA"
    "@kicad-selection-only@@CLRB" "@kicad-selection-only@@unconnected-(J24-Pin_34-Pad34)" "@kicad-selection-only@@unconnected-(J24-Pin_25-Pad25)" "@kicad-selection-only@@unconnected-(J24-Pin_7-Pad7)" "@kicad-selection-only@@unconnected-(J24-Pin_2-Pad2)" "@kicad-selection-only@@unconnected-(J24-Pin_14-Pad14)" "@kicad-selection-only@@unconnected-(J24-Pin_27-Pad27)" "@kicad-selection-only@@unconnected-(J24-Pin_18-Pad18)"
    "@kicad-selection-only@@CHB" "@kicad-selection-only@@unconnected-(J24-Pin_24-Pad24)" "@kicad-selection-only@@unconnected-(J24-Pin_31-Pad31)" "@kicad-selection-only@@unconnected-(J24-Pin_6-Pad6)" "@kicad-selection-only@@unconnected-(J24-Pin_16-Pad16)" "@kicad-selection-only@@unconnected-(J24-Pin_20-Pad20)" "@kicad-selection-only@@unconnected-(J24-Pin_5-Pad5)" "@kicad-selection-only@@unconnected-(J24-Pin_8-Pad8)"
    "@kicad-selection-only@@unconnected-(J24-Pin_36-Pad36)" "@kicad-selection-only@@unconnected-(J24-Pin_23-Pad23)" "@kicad-selection-only@@unconnected-(J24-Pin_29-Pad29)" "@kicad-selection-only@@unconnected-(J24-Pin_13-Pad13)" "@kicad-selection-only@@unconnected-(J24-Pin_12-Pad12)" "@kicad-selection-only@@unconnected-(J24-Pin_22-Pad22)" "@kicad-selection-only@@unconnected-(J24-Pin_4-Pad4)" "@kicad-selection-only@@unconnected-(J24-Pin_40-Pad40)"
    "@kicad-selection-only@@unconnected-(J24-Pin_33-Pad33)" "@kicad-selection-only@@unconnected-(J24-Pin_35-Pad35)" "@kicad-selection-only@@unconnected-(J24-Pin_15-Pad15)" "@kicad-selection-only@@unconnected-(J24-Pin_38-Pad38)" "@kicad-selection-only@@unconnected-(J24-Pin_32-Pad32)" "@kicad-selection-only@@unconnected-(J24-Pin_3-Pad3)" "@kicad-selection-only@@unconnected-(J24-Pin_37-Pad37)" "@kicad-selection-only@@unconnected-(J24-Pin_26-Pad26)"
    "@kicad-selection-only@@unconnected-(J24-Pin_39-Pad39)" "@kicad-selection-only@@unconnected-(J24-Pin_19-Pad19)" "@kicad-selection-only@@unconnected-(J24-Pin_30-Pad30)" "@kicad-selection-only@@unconnected-(J24-Pin_21-Pad21)"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
