    "@kicad-selection-only@@R{slash}~{W}" "@kicad-selection-only@@~{CTS}" "@kicad-selection-only@@~{SCS}" "@kicad-selection-only@@~{SLENB}" "@kicad-selection-only@@S0" "@kicad-selection-only@@S1" "@kicad-selection-only@@S2" "@kicad-selection-only@@~{DATAEN}"
