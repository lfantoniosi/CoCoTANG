
(rules PCB CoCoTANG
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 500)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 71331)
    (layer_rule F.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.6)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.6)
    )
  )
  (rule
    (width 152.4)
    (clearance 152.4)
    (clearance 76.2 (type smd_to_turn_gap))
    (clearance 152.4 (type smd))
    (clearance 152.4 (type "kicad_default"))
    (clearance 152.4 (type GND))
    (clearance 152.4 (type +5V))
    (clearance 152.4 (type kicad))
  )
  (padstack "Via[0-1]_457.2:203.2_um"
    (shape
      (circle F.Cu 457.2 0.0 0.0)
    )
    (shape
      (circle B.Cu 457.2 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_457.2:203.2_um" "Via[0-1]_457.2:203.2_um" default
  )
  (via 
    "Via[0-1]_457.2:203.2_um-kicad_default" "Via[0-1]_457.2:203.2_um" "kicad_default"
  )
  (via 
    "Via[0-1]_457.2:203.2_um-GND" "Via[0-1]_457.2:203.2_um" GND
  )
  (via 
    "Via[0-1]_457.2:203.2_um-+5V" "Via[0-1]_457.2:203.2_um" default
  )
  (via 
    "Via[0-1]_457.2:203.2_um-+3.3V" "Via[0-1]_457.2:203.2_um" default
  )
  (via_rule
    default "Via[0-1]_457.2:203.2_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_457.2:203.2_um-kicad_default"
  )
  (via_rule
    GND "Via[0-1]_457.2:203.2_um-GND"
  )
  (via_rule
    +5V "Via[0-1]_457.2:203.2_um-+5V"
  )
  (via_rule
    +3.3V "Via[0-1]_457.2:203.2_um-+3.3V"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 152.4)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "@kicad-selection-only@@unconnected-(J13-Pin_1-Pad1)" "@kicad-selection-only@@unconnected-(J13-Pin_2-Pad2)" "@kicad-selection-only@@~{HALT}" "@kicad-selection-only@@~{NMI}" "@kicad-selection-only@@~{RESET}" "@kicad-selection-only@@E" "@kicad-selection-only@@Q" "@kicad-selection-only@@~{CART}"
    "@kicad-selection-only@@D0" "@kicad-selection-only@@D1" "@kicad-selection-only@@D2" "@kicad-selection-only@@D3" "@kicad-selection-only@@D4" "@kicad-selection-only@@D5" "@kicad-selection-only@@D6" "@kicad-selection-only@@D7"
    "@kicad-selection-only@@R{slash}~{W}" "@kicad-selection-only@@A0" "@kicad-selection-only@@A1" "@kicad-selection-only@@A2" "@kicad-selection-only@@A3" "@kicad-selection-only@@A4" "@kicad-selection-only@@A5" "@kicad-selection-only@@A6"
    "@kicad-selection-only@@A7" "@kicad-selection-only@@A8" "@kicad-selection-only@@A9" "@kicad-selection-only@@A10" "@kicad-selection-only@@A11" "@kicad-selection-only@@A12" "@kicad-selection-only@@~{CTS}" "@kicad-selection-only@@SND"
    "@kicad-selection-only@@~{SCS}" "@kicad-selection-only@@A13" "@kicad-selection-only@@A14" "@kicad-selection-only@@A15" "@kicad-selection-only@@~{SLENB}" "@kicad-selection-only@@unconnected-(U2-NC-Pad1)" "@kicad-selection-only@@unconnected-(U2-NC-Pad26)"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 152.4)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class GND
    "@kicad-selection-only@@GND"
    (clearance_class GND)
    (via_rule GND)
    (rule
      (width 152.4)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class +5V
    "@kicad-selection-only@@+5V"
    (clearance_class default)
    (via_rule +5V)
    (rule
      (width 152.4)
    )
