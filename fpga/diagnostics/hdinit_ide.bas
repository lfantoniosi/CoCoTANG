10 CLEAR20 B=&HFF5025 REM TOOLSHED IDE AND THE FPGA DEFAULT BOTH USE $FF5030 PRINT "HDB-DOS IDE INIT TEST AT $";HEX$(B)40 S=PEEK(B+7):PRINT "INITIAL STATUS=$";HEX$(S)50 GOSUB 100060 IF Z THEN PRINT "FAIL: BUSY BEFORE $90 STATUS=$";HEX$(S):END70 PRINT "NOT BUSY, STATUS=$";HEX$(S)80 PRINT "WRITE EXECUTE DIAGNOSTIC $90"90 POKE B+7,&H90100 GOSUB 1000110 IF Z THEN PRINT "FAIL: BUSY AFTER $90 STATUS=$";HEX$(S):END120 E=PEEK(B+1)130 PRINT "AFTER $90 STATUS=$";HEX$(S);" ERROR=$";HEX$(E)140 IF E<>1 THEN PRINT "FAIL: HDB-DOS EXPECTS ERROR=$01":END150 PRINT "EXECUTE DIAGNOSTIC PASSED"160 PRINT "SELECT LBA MASTER $E0"170 POKE B+6,&HE0180 GOSUB 1200190 IF Z THEN PRINT "FAIL: MASTER NOT READY STATUS=$";HEX$(S):END200 POKE B+5,0210 POKE B+4,0220 POKE B+3,0230 POKE B+2,1240 PRINT "WRITE IDENTIFY DEVICE $EC"250 POKE B+7,&HEC260 GOSUB 1400270 IF Z THEN PRINT "FAIL: IDENTIFY TIMEOUT STATUS=$";HEX$(S):END280 IF X THEN PRINT "FAIL: IDENTIFY ERROR STATUS=$";HEX$(S):END290 PRINT "IDENTIFY DRQ, STATUS=$";HEX$(S)300 M=0:A0=0:A1=0:A2=0:A3=0310 FOR W=0 TO 255320 L=PEEK(B):H=PEEK(B+8)330 IF W=49 THEN M=H340 IF W=60 THEN A0=L:A1=H350 IF W=61 THEN A2=L:A3=H360 NEXT W370 PRINT "WORD 49 HIGH BYTE=$";HEX$(M)380 IF (M AND 2)=0 THEN PRINT "FAIL: LBA BIT IS CLEAR":END390 N=A0+A1*256+A2*65536+A3*16777216400 PRINT "LBA SUPPORTED, SECTORS=";N410 PRINT "HDINIT DETECTION PASSED"420 END1000 REM HDB-DOS W4NBUSY EQUIVALENT1010 Z=01020 FOR T=1 TO 200001030 S=PEEK(B+7)1040 IF (S AND 128)=0 THEN RETURN1050 NEXT T1060 Z=1:RETURN1200 REM WAIT FOR NOT BUSY AND DRIVE READY1210 Z=01220 FOR T=1 TO 200001230 S=PEEK(B+7)1240 IF (S AND 128)=0 AND (S AND 64)<>0 THEN RETURN1250 NEXT T1260 Z=1:RETURN1400 REM WAIT FOR IDENTIFY DRQ OR ERROR1410 Z=0:X=01420 FOR T=1 TO 200001430 S=PEEK(B+7)1440 IF (S AND 1)<>0 THEN X=1:RETURN1450 IF (S AND 8)<>0 THEN RETURN1460 NEXT T1470 Z=1:RETURN