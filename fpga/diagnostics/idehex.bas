10 CLEAR 409620 WIDTH 80:DIM B(511),O(511)30 BA=&HFF5040 CLS50 PRINT "GLENSIDE IDE SECTOR HEX VIEWER"60 INPUT "LBA (-3 BUFFER, -2 IDENTIFY, -1 QUITS)";SN70 IF SN=-1 THEN WIDTH 32:END80 IF SN<-3 OR SN>268435455 THEN PRINT "INVALID LBA":GOTO 6090 SN=INT(SN):PG=0:HV=0100 GOSUB 1000110 IF ER<>0 THEN GOSUB 4000:GOTO 40120 GOSUB 2000130 K$=INKEY$:IF K$="" THEN 130140 KY=ASC(K$)150 IF K$="Q" OR K$="q" THEN GOTO 40160 IF K$="R" OR K$="r" THEN 300170 IF K$="U" OR K$="u" OR KY=94 OR KY=8 THEN PG=PG-1:IF PG<0 THEN PG=0180 IF K$="D" OR K$="d" OR KY=10 OR KY=9 THEN PG=PG+1:IF PG>1 THEN PG=1190 GOSUB 2000:GOTO 130300 GOSUB 1000310 IF ER<>0 THEN GOSUB 4000:GOTO 40320 GOSUB 2000:GOTO 1301000 REM READ ONE 512-BYTE LBA SECTOR1010 ER=0:CP=HV1020 IF CP=0 THEN 10501030 FOR IX=0 TO 511:O(IX)=B(IX):NEXT IX1050 TM=01060 ST=PEEK(BA+7)1070 IF (ST AND 128)=0 THEN 11001080 TM=TM+1:IF TM<50000 THEN 10601090 ER=1:RETURN1095 IF SN=-3 THEN POKE BA+7,&HE2:GOTO 11601100 IF SN=-2 THEN POKE BA+6,&HE0:POKE BA+7,&HEC:GOTO 11601105 Q=SN1110 POKE BA+3,Q-INT(Q/256)*256:Q=INT(Q/256)1120 POKE BA+4,Q-INT(Q/256)*256:Q=INT(Q/256)1130 POKE BA+5,Q-INT(Q/256)*256:Q=INT(Q/256)1140 POKE BA+6,224+(Q-INT(Q/16)*16)1150 POKE BA+2,1:POKE BA+7,&H201160 TM=01170 ST=PEEK(BA+7)1180 IF (ST AND 1)<>0 THEN ER=2:RETURN1190 IF (ST AND 8)<>0 THEN 12201200 TM=TM+1:IF TM<50000 THEN 11701210 ER=3:RETURN1220 DF=0:CS=01230 FOR IX=0 TO 2551240 B(IX*2)=PEEK(BA):B(IX*2+1)=PEEK(BA+8)1250 NEXT IX1260 FOR IX=0 TO 5111270 CS=CS+B(IX):IF CS>=65536 THEN CS=CS-655361280 IF CP=1 AND B(IX)<>O(IX) THEN DF=DF+11290 NEXT IX1300 HV=1:ST=PEEK(BA+7):RETURN2000 REM DISPLAY 256 BYTES, 16 BYTES PER ROW2010 CLS2015 H$="LBA"+STR$(SN):IF SN=-2 THEN H$="IDENTIFY"2016 IF SN=-3 THEN H$="BUFFER TEST"2020 PRINT H$;2022 PRINT "  PAGE";PG+1;"/2  STATUS $";RIGHT$("0"+HEX$(ST),2);"  SUM $";RIGHT$("000"+HEX$(CS),4);2030 IF CP=1 THEN PRINT "  CHANGED";DF ELSE PRINT2040 PRINT "OFFSET  00 01 02 03 04 05 06 07 08 09 0A 0B 0C 0D 0E 0F  ASCII"2050 FOR RO=0 TO 152060 OF=PG*256+RO*162070 LN$=RIGHT$("000"+HEX$(OF),4)+":  ":AC$=""2080 FOR IX=0 TO 152090 VL=B(OF+IX):HX$=HEX$(VL):IF LEN(HX$)<2 THEN HX$="0"+HX$2100 LN$=LN$+HX$2110 IF CP=1 AND VL<>O(OF+IX) THEN LN$=LN$+"!" ELSE LN$=LN$+" "2120 IF VL>=32 AND VL<=126 THEN AC$=AC$+CHR$(VL) ELSE AC$=AC$+"."2130 NEXT IX2140 PRINT LN$;" ";AC$2150 NEXT RO2160 PRINT2170 PRINT "UP/DOWN OR U/D = PAGE    R = REREAD    Q = NEW SECTOR"2180 RETURN4000 PRINT4010 IF ER=1 THEN PRINT "TIMEOUT WAITING FOR BUSY TO CLEAR"4020 IF ER=2 THEN PRINT "ATA ERROR: STATUS $";HEX$(ST);" ERROR $";HEX$(PEEK(BA+1))4030 IF ER=3 THEN PRINT "TIMEOUT WAITING FOR DATA REQUEST"4040 PRINT "PRESS ANY KEY"4050 K$=INKEY$:IF K$="" THEN 40504060 RETURN