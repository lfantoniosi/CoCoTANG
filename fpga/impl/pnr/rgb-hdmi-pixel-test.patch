@@ -115,9 +116,11 @@ module coco3_hdmi #(
         source_line=(y>=top) ? ((y-top)>>1) : 10'd0;
     end
 
-    // Lead the visible window by one clock for the synchronous line RAM.
+    // The cache registers the address and then the RAM data. Keep its
