diff --git a/fpga/src/video/coco_cvbs_ntsc.v b/fpga/src/video/coco_cvbs_ntsc.v
index 597e2b7..8f1bc7e 100644
--- a/fpga/src/video/coco_cvbs_ntsc.v
+++ b/fpga/src/video/coco_cvbs_ntsc.v
@@ -943,6 +943,17 @@ module coco_cvbs_ntsc #(
     reg [6:0] component_pb_level_135 = 7'd64;
     reg [6:0] component_pr_level_135 = 7'd64;
 
+    // RGB displays every clock of each BT.601 sample. Latch the cache
+    // response once per sample instead of allowing its read-ahead address
+    // to change the colour partway through a displayed dot. Native data is
+    // ready at phase zero; compatibility's 5:4 address step needs two more
+    // clocks through the top-level request register and paged cache.
+    reg rgb_compat_pixel_tick=0;
+    always @(posedge clk135)begin
+        if(!reset_n)rgb_compat_pixel_tick<=0;
+        else rgb_compat_pixel_tick<=sample_phase==4'd2;
+    end
+
     always @(posedge clk135) begin
         if (!reset_n) begin
             sample_phase <= 4'd0;
@@ -1116,7 +1127,9 @@ module coco_cvbs_ntsc #(
                 (source_left_of_picture ? vertical_left_border_rgb :
                                           vertical_right_border_rgb) :
                 border_row_delay2;
-            pixel_rgb <= source_active ? framebuffer_data : border_sample;
+            if(!YPBPR_TO_RGB_LUT ||
+               (picture_high_resolution ? source_sample_tick : rgb_compat_pixel_tick))
+                pixel_rgb <= source_active ? framebuffer_data : border_sample;
 
             encoder_sync <= pixel_sync;
             encoder_burst <= pixel_burst;
