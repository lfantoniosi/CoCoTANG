10 REM SSC ALLOPHONE SPEECH - COLOR COMPUTER
20 POKE &HFF7D,1:POKE &HFF7D,0
30 POKE &HFF01,52:POKE &HFF03,63:POKE &HFF23,60
40 P=&HFF7E:V=176:GOSUB 900
50 READ V:GOSUB 900:IF V<>255 THEN 50
60 PRINT "SAYING COLOR COMPUTER"
70 V=240:GOSUB 900
80 IF (PEEK(P) AND 64)=0 THEN 80
90 PRINT "DONE - ENTER TO REPEAT":LINE INPUT A$
100 GOTO 70
800 DATA 8,15,45,51,4,4,4,8,15,16,9,49,31,13,51,4,255
900 C=0
910 IF (PEEK(P) AND 128)<>0 THEN 940
920 C=C+1:IF C<5000 THEN 910
930 PRINT "SSC BUSY TIMEOUT":END
940 POKE P,V:RETURN
