10 REM SSC ENGLISH TEXT TO SPEECH
20 POKE &HFF7D,1:POKE &HFF7D,0
30 POKE &HFF01,52:POKE &HFF03,63:POKE &HFF23,60
40 P=&HFF7E
50 PRINT "TEXT TO SPEAK (EMPTY=EXIT)"
60 LINE INPUT A$:IF LEN(A$)=0 THEN END
70 FOR I=1 TO LEN(A$):V=ASC(MID$(A$,I,1)):GOSUB 900:NEXT I
80 V=13:GOSUB 900:GOTO 50
900 IF (PEEK(P) AND 128)=0 THEN 900
910 POKE P,V:RETURN
