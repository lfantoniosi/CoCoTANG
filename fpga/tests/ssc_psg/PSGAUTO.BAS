10 REM AUTOMATIC SSC PSG THREE-CHANNEL TEST
20 POKE &HFF7D,1:POKE &HFF7D,0
30 POKE &HFF01,52:POKE &HFF03,63:POKE &HFF23,60
40 P=&HFF7E:V=175:GOSUB 900
50 R=7:D=63:GOSUB 800
60 FOR A=8 TO 10:R=A:D=0:GOSUB 800:NEXT A
70 FOR A=0 TO 2
80 READ T:PRINT "CHANNEL ";CHR$(65+A)
90 R=A*2:D=T:GOSUB 800:R=R+1:D=0:GOSUB 800
100 R=7:D=63-2^A:GOSUB 800
110 R=8+A:D=15:GOSUB 800
120 GOSUB 700
130 R=8+A:D=0:GOSUB 800
140 NEXT A
150 PRINT "THREE-VOICE CHORD"
160 R=7:D=56:GOSUB 800
170 FOR A=8 TO 10:R=A:D=15:GOSUB 800:NEXT A
180 GOSUB 700
190 V=255:GOSUB 900:V=207:GOSUB 900
200 PRINT "DONE - SOUND SHOULD BE SILENT":END
300 DATA 254,202,170
700 S=TIMER
710 IF TIMER<S THEN S=S-65536
720 IF TIMER-S<120 THEN 710
730 RETURN
800 V=R:GOSUB 900:V=D:GOSUB 900:RETURN
900 C=0
910 IF (PEEK(P) AND 128)<>0 THEN 940
920 C=C+1:IF C<5000 THEN 910
930 PRINT "SSC BUSY TIMEOUT":END
940 POKE P,V:RETURN
