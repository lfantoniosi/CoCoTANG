10 REM SSC PRESENCE PROBE USED BY PITFALL II
20 POKE &HFF7D,1:POKE &HFF7D,0
30 P=&HFF7E
40 PRINT "RESET STATUS";PEEK(P)
50 V=32:GOSUB 900:V=13:GOSUB 900
60 S=PEEK(P):PRINT "SPEECH STATUS";S
70 IF (S AND 64)<>0 THEN PRINT "NO SPEECH DETECTED":END
80 PRINT "SSC SPEECH DETECTED"
90 IF (PEEK(P) AND 64)=0 THEN 90
100 PRINT "RETURNED TO IDLE";PEEK(P):END
900 IF (PEEK(P) AND 128)=0 THEN 900
910 POKE P,V:RETURN
