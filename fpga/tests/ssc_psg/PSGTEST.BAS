10 REM SSC TONE TEST - ADAPTED FROM MANUAL PAGE 25
20 POKE &HFF7D,1:POKE &HFF7D,0
30 POKE &HFF01,52:POKE &HFF03,63:POKE &HFF23,60
40 P=&HFF7E:V=175:GOSUB 900
50 R=1:D=0:GOSUB 800
60 R=7:D=62:GOSUB 800
70 R=8:D=15:GOSUB 800
80 INPUT "TONE PERIOD 1-255 (0=STOP)";T
90 IF T=0 THEN 200
100 IF T<1 OR T>255 THEN 80
110 R=0:D=INT(T):GOSUB 800:GOTO 80
200 V=255:GOSUB 900:V=207:GOSUB 900:END
800 V=R:GOSUB 900:V=D:GOSUB 900:RETURN
900 C=0
910 IF (PEEK(P) AND 128)<>0 THEN 940
920 C=C+1:IF C<5000 THEN 910
930 PRINT "SSC BUSY TIMEOUT":END
940 POKE P,V:RETURN
