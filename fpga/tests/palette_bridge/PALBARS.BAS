10 CLEAR 200,&H3FFF
20 LOADM "PALROT.BIN"
30 HSCREEN 2
40 HCLS 0
50 FOR I=0 TO 15
60 HCOLOR I,0
70 X=I*20
80 HLINE(X,0)-(X+19,191),PSET,BF
90 NEXT I
95 SAVEM "BEFORE.BIN",0,&HFEFF,0
100 R=0
110 EXEC &H4000
120 R=R+1
130 FOR D=1 TO 100:NEXT D
140 K$=INKEY$
150 IF K$="" THEN 110
155 SAVEM "AFTER.BIN",0,&HFEFF,0
160 HSCREEN 0
170 PRINT "ROTATIONS";R
180 END
