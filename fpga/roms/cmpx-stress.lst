                      (s/cmpx_stress.asm):00003         ; Exact JSR/RTS + CMPX stress sequence from Color BASIC startup.
                      (s/cmpx_stress.asm):00004         ;
                      (s/cmpx_stress.asm):00005         ; FPGA CoCo 2 ROM image layout:
                      (s/cmpx_stress.asm):00006         ;   image $0000-$1FFF -> CPU $A000-$BFFF and vectors $FFF2-$FFFF
                      (s/cmpx_stress.asm):00007         ;   image $2000-$3FFF -> CPU $8000-$9FFF
                      (s/cmpx_stress.asm):00008         ;
                      (s/cmpx_stress.asm):00009         ; This is assembled from $A000-$DFFF as a file-layout convenience. Bytes at
                      (s/cmpx_stress.asm):00010         ; assembler address $C000 become image offset $2000 and CPU address $8000.
